// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// Programas Nacionales de Formación (creables desde la aplicación)

model Pnf {
  id            String         @id @default(cuid())
  name          String         @unique
  physicalBooks PhysicalBook[]
  bookPnfs      BookPnf[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// Libros físicos

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  physicalBooks PhysicalBook[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PhysicalBook {
  id                String          @id @default(cuid())
  isbn              String?
  code              String?         @unique
  title             String
  yearOfPublication Int
  editorial         String?
  totalStock        Int
  availableStock    Int
  status            BookStatus      @default(DISPONIBLE)
  authors           Author[]
  categories        Category[]
  pnfs              Pnf[]
  operations        BookOperation[]
  copies            BookCopy[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

// Ejemplar / copia física individual de un libro
model BookCopy {
  id           String          @id @default(cuid())
  code         String          @unique
  status       CopyStatus      @default(DISPONIBLE)
  location     String?
  observations String?
  bookId       String
  book         PhysicalBook    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  operations   BookOperation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([bookId, status])
}

model BookOperation {
  id             String        @id @default(cuid())
  bookId         String
  copyId         String?
  type           OperationType
  quantity       Int
  observations   String?
  personId       String?
  wasSettled     Boolean?      @default(false)
  personNames    String
  personSurNames String
  book           PhysicalBook  @relation(fields: [bookId], references: [id])
  copy           BookCopy?     @relation(fields: [copyId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookId, createdAt])
  @@index([copyId])
}

model Operation {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookStatus {
  DISPONIBLE
  AGOTADO
  MANTENIMIENTO
}

enum CopyStatus {
  DISPONIBLE
  PRESTADO
  MANTENIMIENTO
  BAJA
}

enum ItemStatus {
  DISPONIBLE
  AGOTADO
  MANTENIMIENTO
}

enum OperationType {
  ENTRADA
  PRESTAMO
  DEVOLUCION
  BAJA
  AJUSTE
}

// Usuarios, roles y libros guardados

model User {
  id                      Int         @id @default(autoincrement())
  email                   String      @unique
  name                    String
  password                String
  isBlocked               Boolean     @default(false)
  emailVerified           Boolean     @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  resetCode               String?
  resetCodeExpires        DateTime?
  role                    Role        @default(USER)
  saves                   SavedBook[]
  operations              Operation[]
}

enum Role {
  USER
  LIBRARIAN
  ADMIN
}

model Author {
  id            String         @id @default(cuid())
  name          String
  physicalBooks PhysicalBook[]
  books         Book[] // 💡 Cambiado: Relación implícita limpia para alinearse al orden alfabético de Postgres
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Book {
  id          Int         @id @default(autoincrement())
  title       String
  pnfs        BookPnf[]
  authors     Author[] // 💡 Cambiado: Relación implícita limpia para alinearse al orden alfabético de Postgres
  description String?
  routepdf    String
  routeimg    String?
  createAt    DateTime    @default(now())
  updateAt    DateTime    @updatedAt
  savedby     SavedBook[]
}

// Tabla intermedia para Book y Pnf
model BookPnf {
  id        String   @id @default(cuid())
  bookId    Int
  pnfId     String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pnf       Pnf      @relation(fields: [pnfId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, pnfId])
}

model SavedBook {
  id      Int      @id @default(autoincrement())
  saveeAt DateTime @default(now())

  book   Book @relation(fields: [bookId], references: [id])
  bookId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

// Inventario

model Item {
  id             String     @id @default(cuid())
  name           String
  code           String?
  description    String?
  totalStock     Int
  availableStock Int
  status         ItemStatus
  types          ItemType[]

  itemOperations ItemOperation[]
  copies         ItemCopy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ejemplar / copia individual de un artículo de inventario
model ItemCopy {
  id           String          @id @default(cuid())
  code         String          @unique
  status       CopyStatus      @default(DISPONIBLE)
  location     String?
  observations String?
  itemId       String
  item         Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  operations   ItemOperation[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([itemId, status])
}

model ItemOperation {
  id             String        @id @default(cuid())
  itemId         String
  copyId         String?
  type           OperationType
  quantity       Int
  observations   String?
  personId       String?
  wasSettled     Boolean?      @default(false)
  personNames    String
  personSurNames String
  item           Item          @relation(fields: [itemId], references: [id])
  copy           ItemCopy?     @relation(fields: [copyId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([itemId, createdAt])
  @@index([copyId])
}

model ItemType {
  id    String @id @default(cuid())
  name  String
  items Item[]
}
