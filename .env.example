# Copia este archivo a `.env` y reemplaza los valores con tus credenciales reales.
# NUNCA subas `.env` al repositorio.

# String de conexión de PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secreto para firmar los JWT. Usa un valor largo y aleatorio, ej:
# openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Supabase (almacenamiento/consulta)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_KEY="tu-clave"

# API key de Groq (funciones IA)
GROQ_API_KEY="gsk_..."

# true cuando se ejecuta en local, false en producción
isLocal=false

# Puerto del servidor
PORT=3000

# Correo saliente para verificación y recuperación de contraseña.
# Proveedor: "gmail" para Gmail o "smtp" para un servidor SMTP genérico.
MAIL_SERVICE="gmail"
MAIL_USER="tu-correo@gmail.com"
# Remitente que verán los usuarios. Si se omite, se usa MAIL_USER.
MAIL_FROM="UPTALib <tu-correo@gmail.com>"

# Opción A (recomendada para Gmail): OAuth2 de Google Cloud.
# Crea credenciales OAuth 2.0 de tipo "Aplicación de escritorio" y genera un
# refresh token con el scope https://mail.google.com/ para la cuenta MAIL_USER.
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
GOOGLE_REFRESH_TOKEN="tu-refresh-token"

# Opción B (alternativa para Gmail): contraseña de aplicación.
# Requiere verificación en dos pasos en la cuenta y no es la contraseña normal.
MAIL_PASSWORD=""

# Solo para MAIL_SERVICE="smtp" con un servidor distinto de Gmail.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
# "true" para el puerto 465 (SSL), "false" para 587 (STARTTLS)
MAIL_SECURE=false

# Token compartido para la sincronización offline-first (Electron ⇄ Backend).
# Sin este valor, los endpoints /sync/* quedan deshabilitados (503).
# Genera uno con: openssl rand -hex 32
SYNC_TOKEN="cambia-esto-por-un-token-largo-y-aleatorio"