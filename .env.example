# Copia este archivo a `.env` y reemplaza los valores con tus credenciales reales.
# NUNCA subas `.env` al repositorio.

# String de conexión de PostgreSQL (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secreto para firmar los JWT. Usa un valor largo y aleatorio, ej:
# openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Supabase (almacenamiento/consulta)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_KEY="tu-clave"

# API key de Groq (funciones IA)
GROQ_API_KEY="gsk_..."

# true cuando se ejecuta en local, false en producción
isLocal=false

# Puerto del servidor
PORT=3000