// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

// Libros físicos

model Category {
  id            String         @id @default(cuid())
  name          String         @unique
  physicalBooks PhysicalBook[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model PhysicalBook {
  id                String          @id @default(cuid())
  isbn              String?
  title             String
  authorId          String
  categoryId        String
  pnf               Pnf?
  yearOfPublication Int
  editorial         String?
  totalStock        Int
  availableStock    Int
  status            BookStatus      @default(DISPONIBLE)
  author            Author          @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  operations        BookOperation[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model BookOperation {
  id             String        @id @default(cuid())
  bookId         String
  type           OperationType
  quantity       Int
  observations   String?
  personId       String?
  wasSettled     Boolean?      @default(false)
  personNames    String
  personSurNames String
  book           PhysicalBook  @relation(fields: [bookId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([bookId, createdAt])
}

model Operation {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  ip        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BookStatus {
  DISPONIBLE
  AGOTADO
  MANTENIMIENTO
}

enum ItemStatus {
  DISPONIBLE
  AGOTADO
  MANTENIMIENTO
}

enum Pnf {
  GENERAL
  INFORMATICA
  ELECTRONICA
  MANTENIMIENTO
  CONTADURIA
  ADMINISTRACION
  ELECTRICIDAD
  MECANICA
  INSTRUMENTACION
  TELECOMUNICACIONES
}

enum OperationType {
  ENTRADA
  PRESTAMO
  DEVOLUCION
  BAJA
  AJUSTE
}

// Usuarios, roles y libros guardados

model User {
  id         Int         @id @default(autoincrement())
  email      String      @unique
  name       String
  password   String
  isBlocked  Boolean     @default(false)
  role       Role        @default(USER)
  saves      SavedBook[]
  operations Operation[]
}

enum Role {
  USER
  LIBRARIAN
  ADMIN
}

model Author {
  id            String         @id @default(cuid())
  name          String
  physicalBooks PhysicalBook[]
  books         Book[] // 💡 Cambiado: Relación implícita limpia para alinearse al orden alfabético de Postgres
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Book {
  id          Int         @id @default(autoincrement())
  title       String
  pnfs        BookPnf[]
  authors     Author[] // 💡 Cambiado: Relación implícita limpia para alinearse al orden alfabético de Postgres
  description String?
  routepdf    String
  routeimg    String?
  createAt    DateTime    @default(now())
  updateAt    DateTime    @updatedAt
  savedby     SavedBook[]
}

// Tabla intermedia para Book y Pnf
model BookPnf {
  id        String   @id @default(cuid())
  bookId    Int
  pnf       Pnf
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([bookId, pnf])
}

model SavedBook {
  id      Int      @id @default(autoincrement())
  saveeAt DateTime @default(now())

  book   Book @relation(fields: [bookId], references: [id])
  bookId Int

  user   User @relation(fields: [userId], references: [id])
  userId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, bookId])
}

// Inventario

model Item {
  id             String     @id @default(cuid())
  name           String
  code           String?
  description    String?
  totalStock     Int
  availableStock Int
  type           ItemType   @relation(fields: [typeId], references: [id])
  typeId         String
  status         ItemStatus

  itemOperations ItemOperation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemOperation {
  id             String        @id @default(cuid())
  itemId         String
  type           OperationType
  quantity       Int
  observations   String?
  personId       String?
  wasSettled     Boolean?      @default(false)
  personNames    String
  personSurNames String
  item           Item          @relation(fields: [itemId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([itemId, createdAt])
}

model ItemType {
  id    String @id @default(cuid())
  name  String
  items Item[]
}
